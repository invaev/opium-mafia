{
  "name": "opium-mafia-server",
  "version": "0.1.0",
  "description": "Opium Mafia game server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && cp -r src/assets dist/assets 2>/dev/null || true",
    "start": "prisma db push --accept-data-loss && node --disable-warning=DEP0040 dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.19.1",
    "ioredis": "^5.4.1",
    "grammy": "^1.30.0",
    "fastify-plugin": "^4.5.1",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "prisma": "^5.19.1",
    "@types/node": "^22.5.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12"
  },
  "author": "Imran Valiyev <imran.valiyev@vaevi.com>",
  "homepage": "https://vaevi.com"
}
